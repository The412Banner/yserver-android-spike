+/// Bannerlator: a Wine window (one with the patched-Wine `_NET_WM_HWND`) is
+/// being mapped. One line on yserver's log for the launcher, which brings
+/// the window to the front inside Wine (winhandler.exe), as its Java X server
+/// does on every map: `YSERVER-MAP hwnd=0x… pid=… class=…`.
+fn notify_wine_window_map(state: &ServerState, window: ResourceId) {
+    let Some(hwnd_atom) = state.atoms.id_for("_NET_WM_HWND") else {
+        return;
+    };
+    let Some(hwnd) = state
+        .resources
+        .window_property(window, hwnd_atom)
+        .filter(|v| v.data.len() >= 4)
+        .map(|v| {
+            let mut b = [0u8; 8];
+            let n = v.data.len().min(8);
+            b[..n].copy_from_slice(&v.data[..n]);
+            u64::from_le_bytes(b)
+        })
+    else {
+        return;
+    };
+    let pid = state
+        .atoms
+        .id_for("_NET_WM_PID")
+        .and_then(|a| state.resources.window_property(window, a))
+        .filter(|v| v.data.len() >= 4)
+        .map_or(0, |v| u32::from_le_bytes([v.data[0], v.data[1], v.data[2], v.data[3]]));
+    // WM_CLASS: instance NUL class NUL; the class is what winhandler matches.
+    let class = state
+        .atoms
+        .id_for("WM_CLASS")
+        .and_then(|a| state.resources.window_property(window, a))
+        .map(|v| {
+            let mut parts = v.data.split(|&b| b == 0).filter(|p| !p.is_empty());
+            let instance = parts.next().unwrap_or_default();
+            let class = parts.next().unwrap_or(instance);
+            String::from_utf8_lossy(class).replace(char::is_whitespace, "_")
+        })
+        .unwrap_or_default();
+    log::info!(
+        target: "yserver::bannerlator",
+        "YSERVER-MAP window=0x{:x} hwnd=0x{hwnd:x} pid={pid} class={class}",
+        window.0
+    );
+}
+
 pub(super) fn handle_map_window(
     state: &mut ServerState,
     backend: &mut dyn Backend,
@@ -2714,6 +2760,7 @@ pub(super) fn handle_map_window(
         );
         return Ok(RequestOutcome::Handled);
     }
+    notify_wine_window_map(state, window);
 
