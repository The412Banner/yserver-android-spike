@@ -0,0 +1,135 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="banner_ahb_v1">
+  <copyright>
+    Copyright 2026 The412Banner
+
+    Permission is hereby granted, free of charge, to any person obtaining a
+    copy of this software and associated documentation files (the "Software"),
+    to deal in the Software without restriction, including without limitation
+    the rights to use, copy, modify, merge, publish, distribute, sublicense,
+    and/or sell copies of the Software, and to permit persons to whom the
+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <interface name="banner_ahb_v1" version="3">
+    <description summary="Android gralloc buffers behind dma-buf wl_buffers">
+      Zero-copy window layers on Android. A Vulkan swapchain image that the
+      client allocated as an Android AHardwareBuffer (gralloc) is still shared
+      as a dma-buf through zwp_linux_dmabuf_v1, so the compositor can import
+      and draw it the usual way. This interface additionally hands the
+      compositor the AHardwareBuffer itself, once per wl_buffer, so the
+      compositor can put the buffer straight on an Android SurfaceControl
+      layer (SurfaceFlinger / the display hardware composite it) without
+      copying it.
+
+      The AHardwareBuffer travels over a Unix socket: the client creates a
+      socketpair, writes the buffer's handle into one end with
+      AHardwareBuffer_sendHandleToUnixSocket, then sends the other end in the
+      attach request. The compositor reads it with
+      AHardwareBuffer_recvHandleFromUnixSocket and closes the socket. Its
+      reference to the AHardwareBuffer lives as long as the wl_buffer (plus
+      whatever the display still holds).
+
+      The compositor advertises this global whenever it can put buffers on a
+      display layer at all; whether it WANTS gralloc buffers right now is the
+      mode event (version 2), sent on bind and every time the user switches
+      zero-copy on or off during the session. A client decides per swapchain,
+      when it creates the swapchain, from the last mode it received, and a
+      client whose live swapchain was built for the other mode retires it
+      (VK_ERROR_OUT_OF_DATE_KHR on its next acquire or present) so the program
+      rebuilds it for the new mode. Buffers of the old swapchain stay fully
+      presentable until then: an attached AHardwareBuffer keeps its association
+      for the wl_buffer's lifetime whatever the mode is now. A version 1
+      client (no mode event) keeps deciding from its own environment. A
+      client that does not see the global (or does not want it) allocates
+      swapchain images the standard way; nothing else changes.
+
+      Synchronisation is implicit by default: the dma-buf carries the client's
+      render fence (DMA_BUF_IOCTL_IMPORT_SYNC_FILE by the client's driver), the
+      compositor exports it as the layer's acquire fence, and the compositor
+      imports the display's release fence into the dma-buf before it sends
+      wl_buffer.release, so the client's next acquire waits on it.
+
+      Kernels without the dma-buf sync_file ioctls (ENOTTY on both) break
+      that chain: the compositor cannot export an acquire fence and the display
+      may scan out a buffer still being written. Version 3 adds the fence
+      request for exactly that case: the client hands over its render-complete
+      fence as a sync_file (the SYNC_FD export of the semaphore or fence its
+      present signals, VK_KHR_external_semaphore_fd / VK_KHR_external_fence_fd,
+      which needs no dma-buf ioctl), once per commit, and the compositor uses
+      it as the layer's acquire fence instead of exporting one. The release
+      direction is unchanged: when the import of the display's release fence
+      fails too, the compositor waits for it before wl_buffer.release.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the object">
+        Buffers already attached keep their AHardwareBuffer association.
+      </description>
+    </request>
+
+    <request name="attach">
+      <description summary="hand the compositor a buffer's AHardwareBuffer">
+        Associates the AHardwareBuffer readable from socket with the
+        (already created) dma-buf wl_buffer. width, height and stride
+        (pixels) describe the gralloc allocation; modifier_hi/lo is the DRM
+        format modifier the dma-buf was shared with (the same value passed to
+        zwp_linux_buffer_params_v1.add); image_count is the number of images
+        in the swapchain this buffer belongs to (for the compositor's log).
+        Sent once per wl_buffer, before the buffer is first attached to a
+        surface.
+      </description>
+      <arg name="buffer" type="object" interface="wl_buffer" summary="the dma-buf wl_buffer"/>
+      <arg name="socket" type="fd" summary="socket the AHardwareBuffer handle was written to"/>
+      <arg name="width" type="uint" summary="buffer width in pixels"/>
+      <arg name="height" type="uint" summary="buffer height in pixels"/>
+      <arg name="stride" type="uint" summary="gralloc row stride in pixels"/>
+      <arg name="modifier_hi" type="uint" summary="high 32 bits of the DRM format modifier"/>
+      <arg name="modifier_lo" type="uint" summary="low 32 bits of the DRM format modifier"/>
+      <arg name="image_count" type="uint" summary="images in the client's swapchain"/>
+    </request>
+
+    <event name="mode" since="2">
+      <description summary="whether the compositor wants gralloc swapchain images now">
+        Sent once right after bind and again whenever the compositor's
+        zero-copy state flips (the in-game switch). enabled = 1: swapchains
+        created from now on should use gralloc AHardwareBuffers and attach
+        them; 0: standard buffers. A live swapchain built for the other value
+        should be retired by the client (out of date) so the program rebuilds
+        it; until it is, its buffers are shown as before.
+      </description>
+      <arg name="enabled" type="uint" summary="1 = gralloc swapchain images wanted, 0 = not"/>
+    </event>
+
+    <request name="fence" since="3">
+      <description summary="the client's render-complete fence for a buffer's next commit">
+        fd is a sync_file that signals when the client's rendering into buffer
+        (a wl_buffer an AHardwareBuffer was attached to) is complete; the
+        compositor owns the fd from here. Sent after the work that renders the
+        frame is submitted and before the wl_surface.commit that shows buffer;
+        it applies to that one commit. A fence sent for a buffer without an
+        attached AHardwareBuffer is closed and ignored. A second fence for the
+        same buffer before the compositor used the first replaces it. When the
+        compositor can export the fence from the dma-buf itself, a client may
+        still send one: the client's fence is preferred, as it is exactly the
+        render-complete point and not every fence the dma-buf carries. The
+        compositor never requires it: a version 3 client that sends none is
+        treated like a version 2 client.
+      </description>
+      <arg name="buffer" type="object" interface="wl_buffer" summary="the dma-buf wl_buffer the fence is for"/>
+      <arg name="fd" type="fd" summary="sync_file: signals when rendering into buffer is complete"/>
+    </request>
+  </interface>
+</protocol>
diff --git a/crates/yserver/src/rootless/ahb.rs b/crates/yserver/src/rootless/ahb.rs
new file mode 100644
index 0000000..ee28394
--- /dev/null
+++ b/crates/yserver/src/rootless/ahb.rs
@@ -0,0 +1,414 @@
+//! Android: a window's backing reaches the host as one of a small pool of
+//! AHardwareBuffers, filled by a GPU copy (no CPU readback). The host shows
+//! the buffer (a dma-buf `wl_buffer` plus `banner_ahb_v1`) and gives it back
+//! once the window system released it (`FrameEvent::AhbReleased`).
+
+use std::{rc::Rc, sync::Arc};
+
+use ash::vk;
+use yserver_core::rootless::{Rect, ToplevelId};
+
+use super::{
+    frames::WindowFrames,
+    host::{AhbFrame, FrameSeq, RootlessHost},
+    window_swapchain::record_backing_copy,
+};
+use crate::kms::{
+    render::{
+        gpu::{FenceTicket, GpuCore},
+        store::{DrawableId, DrawableStore},
+    },
+    vk::{ahb, device::VkContext},
+};
+
+/// Buffers per window: one shown, one queued in the compositor, one filling.
+const POOL: usize = 3;
+
+const USAGE: u64 = ahb::USAGE_GPU_SAMPLED_IMAGE
+    | ahb::USAGE_GPU_FRAMEBUFFER
+    | ahb::USAGE_COMPOSER_OVERLAY
+    | ahb::USAGE_CPU_READ_RARELY;
+
+struct Slot {
+    buffer: Rc<ahb::Ahb>,
+    image: vk::Image,
+    memory: vk::DeviceMemory,
+    /// Row stride in pixels.
+    stride: u32,
+    /// The host has it (shown, queued, or being filled for it).
+    held: bool,
+}
+
+struct InFlight {
+    slot: usize,
+    seq: FrameSeq,
+    ticket: FenceTicket,
+}
+
+/// What the tick needs of the backend.
+pub(crate) struct AhbTick<'a> {
+    pub vk: &'a Arc<VkContext>,
+    pub store: &'a mut DrawableStore,
+    pub gpu: &'a GpuCore,
+}
+
+pub(crate) struct AhbState {
+    vk: Option<Arc<VkContext>>,
+    backing: Option<DrawableId>,
+    /// A frame is owed whatever the store says: a new window or generation.
+    needs_frame: bool,
+    failed: bool,
+    pool_gen: u64,
+    extent: vk::Extent2D,
+    slots: Vec<Slot>,
+    cmd_pool: vk::CommandPool,
+    cbs: Vec<vk::CommandBuffer>,
+    in_flight: Option<InFlight>,
+}
+
+impl AhbState {
+    pub(crate) fn new() -> Self {
+        Self {
+            vk: None,
+            backing: None,
+            needs_frame: true,
+            failed: false,
+            pool_gen: 0,
+            extent: vk::Extent2D::default(),
+            slots: Vec::new(),
+            cmd_pool: vk::CommandPool::null(),
+            cbs: Vec::new(),
+            in_flight: None,
+        }
+    }
+
+    pub(crate) fn backing(&self) -> Option<DrawableId> {
+        self.backing
+    }
+
+    pub(crate) fn new_generation(&mut self, backing: DrawableId) {
+        self.backing = Some(backing);
+        self.needs_frame = true;
+    }
+
+    /// The host made its window anew: every buffer is free, a frame is owed.
+    pub(crate) fn restart(&mut self) {
+        for slot in &mut self.slots {
+            slot.held = false;
+        }
+        self.needs_frame = true;
+    }
+
+    pub(crate) fn in_flight(&self) -> bool {
+        self.in_flight.is_some()
+    }
+
+    pub(crate) fn has_work(&self, store: &DrawableStore) -> bool {
+        self.needs_frame
+            || self.backing.is_some_and(|b| {
+                store
+                    .peek_presentation_damage(b)
+                    .is_some_and(|s| !s.region.is_empty())
+            })
+    }
+
+    fn free_slot(&self) -> Option<usize> {
+        if self.slots.is_empty() {
+            return Some(0);
+        }
+        self.slots.iter().position(|s| !s.held)
+    }
+
+    /// The tick would start a copy now.
+    pub(crate) fn wants_frame(&self, frames: &WindowFrames, store: &DrawableStore) -> bool {
+        !self.failed
+            && self.in_flight.is_none()
+            && self.backing.is_some()
+            && frames.can_submit()
+            && self.free_slot().is_some()
+            && self.has_work(store)
+    }
+
+    /// A buffer the host gave back.
+    pub(crate) fn on_released(&mut self, pool: u64, slot: u32) {
+        if pool != self.pool_gen {
+            return;
+        }
+        if let Some(s) = self.slots.get_mut(slot as usize) {
+            s.held = false;
+        }
+    }
+
+    /// Hand a finished copy to the host, then start the next one when one
+    /// is wanted. `true` when something moved.
+    pub(crate) fn tick(
+        &mut self,
+        id: ToplevelId,
+        depth: u8,
+        frames: &mut WindowFrames,
+        host: &mut dyn RootlessHost,
+        t: &mut AhbTick<'_>,
+    ) -> bool {
+        let mut moved = self.hand_over(id, depth, host, t.vk);
+        if !self.wants_frame(frames, t.store) {
+            return moved;
+        }
+        let Some(backing) = self.backing else {
+            return moved;
+        };
+        let Some(extent) = t.store.get(backing).map(|d| d.storage.extent) else {
+            return moved;
+        };
+        if self.slots.is_empty() || self.extent != extent {
+            if let Err(e) = self.build_pool(t.vk, extent) {
+                log::warn!("rootless: AHardwareBuffer pool for {id:?} ({}x{}): {e}", extent.width, extent.height);
+                self.failed = true;
+                return moved;
+            }
+            log::info!(
+                "rootless: {id:?} goes to the host as AHardwareBuffers ({}x{}, {} buffers, pool {})",
+                extent.width,
+                extent.height,
+                self.slots.len(),
+                self.pool_gen
+            );
+        }
+        let Some(index) = self.slots.iter().position(|s| !s.held) else {
+            return moved;
+        };
+        let snapshot = t
+            .store
+            .peek_presentation_damage(backing)
+            .filter(|s| !s.region.is_empty());
+        let vk = Arc::clone(t.vk);
+        let cb = self.cbs[index];
+        let image = self.slots[index].image;
+        if let Err(e) = Self::record(&vk, t.store, backing, cb, image, extent) {
+            log::warn!("rootless: AHardwareBuffer copy for {id:?}: {e:?}");
+            return moved;
+        }
+        let ticket = match t.gpu.acquire_fence_ticket() {
+            Ok(ticket) => ticket,
+            Err(e) => {
+                log::warn!("rootless: no fence for {id:?}: {e:?}");
+                return moved;
+            }
+        };
+        let cbs = [vk::CommandBufferSubmitInfo::default().command_buffer(cb)];
+        let submit = [vk::SubmitInfo2::default().command_buffer_infos(&cbs)];
+        // SAFETY: the queue is used from the core thread only.
+        if let Err(e) = unsafe { vk.device.queue_submit2(vk.graphics_queue, &submit, ticket.fence()) } {
+            log::warn!("rootless: AHardwareBuffer copy submit for {id:?}: {e:?}");
+            return moved;
+        }
+        t.store.touch_render_fence(backing, ticket.clone());
+        let full = Rect {
+            x: 0,
+            y: 0,
+            width: u16::try_from(extent.width).unwrap_or(u16::MAX),
+            height: u16::try_from(extent.height).unwrap_or(u16::MAX),
+        };
+        let seq = frames.submitted(vec![full], snapshot.map(|s| s.epoch));
+        self.slots[index].held = true;
+        self.needs_frame = false;
+        self.in_flight = Some(InFlight {
+            slot: index,
+            seq,
+            ticket,
+        });
+        moved = true;
+        // A small copy has often finished by now.
+        self.hand_over(id, depth, host, t.vk);
+        moved
+    }
+
+    /// The copy in flight, finished, to the host.
+    fn hand_over(&mut self, id: ToplevelId, depth: u8, host: &mut dyn RootlessHost, vk: &VkContext) -> bool {
+        let Some(f) = self.in_flight.as_ref() else {
+            return false;
+        };
+        if !f.ticket.poll_signaled(vk) {
+            return false;
+        }
+        let f = self.in_flight.take().expect("checked above");
+        let slot = &self.slots[f.slot];
+        host.submit_ahb(AhbFrame {
+            id,
+            seq: f.seq,
+            pool: self.pool_gen,
+            slot: u32::try_from(f.slot).unwrap_or(0),
+            pool_size: u32::try_from(self.slots.len()).unwrap_or(0),
+            buffer: Rc::clone(&slot.buffer),
+            width: self.extent.width,
+            height: self.extent.height,
+            stride: slot.stride,
+            depth,
+        });
+        true
+    }
+
+    fn record(
+        vk: &VkContext,
+        store: &mut DrawableStore,
+        backing: DrawableId,
+        cb: vk::CommandBuffer,
+        image: vk::Image,
+        extent: vk::Extent2D,
+    ) -> Result<(), vk::Result> {
+        let device = &vk.device;
+        unsafe {
+            device.reset_command_buffer(cb, vk::CommandBufferResetFlags::empty())?;
+            device.begin_command_buffer(
+                cb,
+                &vk::CommandBufferBeginInfo::default()
+                    .flags(vk::CommandBufferUsageFlags::ONE_TIME_SUBMIT),
+            )?;
+        }
+        let Some((src, src_extent)) = store.begin_external_read(backing, vk, cb) else {
+            unsafe { device.end_command_buffer(cb) }?;
+            return Err(vk::Result::ERROR_UNKNOWN);
+        };
+        // SAFETY: a recording command buffer; both images are this device's.
+        unsafe {
+            record_backing_copy(device, cb, src, src_extent, image, extent, 1, vk::ImageLayout::GENERAL);
+        }
+        store.end_external_read(backing, vk, cb);
+        unsafe { device.end_command_buffer(cb) }
+    }
+
+    /// A pool at `extent`; the old one goes once the GPU is done with it
+    /// (the compositor holds its own references to what it shows).
+    fn build_pool(&mut self, vk: &Arc<VkContext>, extent: vk::Extent2D) -> Result<(), String> {
+        self.destroy_slots();
+        let Some(ext) = vk.ahb.as_ref() else {
+            return Err("no VK_ANDROID_external_memory_android_hardware_buffer".into());
+        };
+        if self.cmd_pool == vk::CommandPool::null() {
+            let info = vk::CommandPoolCreateInfo::default()
+                .flags(vk::CommandPoolCreateFlags::RESET_COMMAND_BUFFER)
+                .queue_family_index(vk.graphics_queue_family);
+            self.cmd_pool = unsafe { vk.device.create_command_pool(&info, None) }
+                .map_err(|e| format!("command pool: {e:?}"))?;
+            let alloc = vk::CommandBufferAllocateInfo::default()
+                .command_pool(self.cmd_pool)
+                .level(vk::CommandBufferLevel::PRIMARY)
+                .command_buffer_count(u32::try_from(POOL).unwrap_or(3));
+            self.cbs = unsafe { vk.device.allocate_command_buffers(&alloc) }
+                .map_err(|e| format!("command buffers: {e:?}"))?;
+        }
+        self.vk = Some(Arc::clone(vk));
+        let mem_props = unsafe { vk.instance.get_physical_device_memory_properties(vk.physical_device) };
+        for _ in 0..POOL {
+            let buffer = ahb::allocate(extent.width, extent.height, ahb::FORMAT_B8G8R8A8, USAGE)
+                .map_err(|e| format!("AHardwareBuffer_allocate: {e}"))?;
+            let desc = buffer.describe();
+            let mut format_props = vk::AndroidHardwareBufferFormatPropertiesANDROID::default();
+            let (allocation_size, memory_type_bits) = {
+                let mut props =
+                    vk::AndroidHardwareBufferPropertiesANDROID::default().push_next(&mut format_props);
+                unsafe { ext.get_android_hardware_buffer_properties(buffer.as_ptr().cast_const(), &mut props) }
+                    .map_err(|e| format!("buffer properties: {e:?}"))?;
+                (props.allocation_size, props.memory_type_bits)
+            };
+            let format = format_props.format;
+            if format == vk::Format::UNDEFINED {
+                return Err("the buffer has no Vulkan format".into());
+            }
+            let mut external = vk::ExternalMemoryImageCreateInfo::default()
+                .handle_types(vk::ExternalMemoryHandleTypeFlags::ANDROID_HARDWARE_BUFFER_ANDROID);
+            let image_info = vk::ImageCreateInfo::default()
+                .image_type(vk::ImageType::TYPE_2D)
+                .format(format)
+                .extent(vk::Extent3D {
+                    width: extent.width,
+                    height: extent.height,
+                    depth: 1,
+                })
+                .mip_levels(1)
+                .array_layers(1)
+                .samples(vk::SampleCountFlags::TYPE_1)
+                .tiling(vk::ImageTiling::OPTIMAL)
+                .usage(
+                    vk::ImageUsageFlags::TRANSFER_DST
+                        | vk::ImageUsageFlags::SAMPLED
+                        | vk::ImageUsageFlags::COLOR_ATTACHMENT,
+                )
+                .sharing_mode(vk::SharingMode::EXCLUSIVE)
+                .initial_layout(vk::ImageLayout::UNDEFINED)
+                .push_next(&mut external);
+            let image = unsafe { vk.device.create_image(&image_info, None) }
+                .map_err(|e| format!("image: {e:?}"))?;
+            let Some(type_index) = (0..mem_props.memory_type_count)
+                .find(|i| memory_type_bits & (1 << i) != 0)
+            else {
+                unsafe { vk.device.destroy_image(image, None) };
+                return Err("no memory type".into());
+            };
+            let mut import = vk::ImportAndroidHardwareBufferInfoANDROID::default().buffer(buffer.as_ptr());
+            let mut dedicated = vk::MemoryDedicatedAllocateInfo::default().image(image);
+            let alloc = vk::MemoryAllocateInfo::default()
+                .allocation_size(allocation_size)
+                .memory_type_index(type_index)
+                .push_next(&mut import)
+                .push_next(&mut dedicated);
+            let memory = match unsafe { vk.device.allocate_memory(&alloc, None) } {
+                Ok(m) => m,
+                Err(e) => {
+                    unsafe { vk.device.destroy_image(image, None) };
+                    return Err(format!("import: {e:?}"));
+                }
+            };
+            if let Err(e) = unsafe { vk.device.bind_image_memory(image, memory, 0) } {
+                unsafe {
+                    vk.device.free_memory(memory, None);
+                    vk.device.destroy_image(image, None);
+                }
+                return Err(format!("bind: {e:?}"));
+            }
+            self.slots.push(Slot {
+                buffer: Rc::new(buffer),
+                image,
+                memory,
+                stride: if desc.stride != 0 { desc.stride } else { extent.width },
+                held: false,
+            });
+        }
+        self.pool_gen += 1;
+        self.extent = extent;
+        Ok(())
+    }
+
+    /// The GPU must be done with every slot (no copy in flight).
+    fn destroy_slots(&mut self) {
