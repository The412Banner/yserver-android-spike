 /// path and supersession's decision about whether a fence waiter is parked
 /// for a future target. Keep the general clock, epoch fallback, and in-flight
 /// flip handling in one place so those decisions cannot drift apart.
+/// Bannerlator newest-frame-only: a converted present for the next host frame
+/// parks as if behind a flip (at arrival and at every re-check), so a newer one
+/// can replace it before the frame it waits for.
+fn latest_parks(pending: &PendingPresentPixmap) -> bool {
+    match &pending.request {
+        PendingPresentRequest::Pixmap(req) => {
+            crate::bannerlator::present_latest_parks(req.options, req.target_msc, req.divisor)
+        }
+        PendingPresentRequest::PixmapSynced(_) => false,
+    }
