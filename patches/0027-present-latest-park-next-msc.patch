@@ -45,6 +45,23 @@ pub fn present_latest() -> bool {
     *ON.get_or_init(|| std::env::var("YSERVER_PRESENT_LATEST").map_or(true, |v| v != "0"))
 }
 
+/// `YSERVER_PRESENT_ASYNC=1`: presents run at once unless a frame cap is set.
+pub fn present_async_forced() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("YSERVER_PRESENT_ASYNC").is_some_and(|v| v == "1"))
+}
+
+/// A present newest-frame-only holds until the next host frame. In copy mode
+/// a present for the next MSC otherwise runs at once (only a flip in flight
+/// parks it), so nothing newer could ever replace it.
+pub fn present_latest_parks(options: u32, target_msc: u64, divisor: u64) -> bool {
+    present_latest()
+        && present_async_forced()
+        && crate::frame_cap::cap_mhz() == 0
+        && (options & crate::present_scheduler::PRESENT_ALL_ASYNC_OPTIONS != 0
+            || (target_msc == 0 && divisor == 0))
+}
