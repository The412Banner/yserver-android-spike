+/// The `w`x`h` part of a Z-pixmap wire image at (`sx`, `sy`), as a wire
+/// image of its own. Byte-per-pixel depths only (8, 24, 32); `None` for
+/// the bit-packed ones or a part outside the image.
+fn z_pixmap_sub_image(data: &[u8], depth: u8, width: u16, sx: usize, sy: usize, w: u16, h: u16) -> Option<Vec<u8>> {
+    let bpp = match depth {
+        8 => 1,
+        24 | 32 => 4,
+        _ => return None,
+    };
+    let src_stride = z_pixmap_row_stride(depth, u32::from(width));
+    let dst_stride = z_pixmap_row_stride(depth, u32::from(w));
+    let row = usize::from(w) * bpp;
+    let mut out = vec![0u8; dst_stride * usize::from(h)];
+    for y in 0..usize::from(h) {
+        let start = (sy + y) * src_stride + sx * bpp;
+        let src = data.get(start..start + row)?;
+        out[y * dst_stride..y * dst_stride + row].copy_from_slice(src);
+    }
+    Some(out)
+}
