+/// How long the core thread waits for a copy before leaving it to the poll:
+/// `YSERVER_COPY_WAIT_US`, 0 (no wait) by default. Every client stalls while
+/// it waits, and the copy queues behind the game's own GPU work.
+fn copy_wait_ns() -> u64 {
+    static WAIT: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *WAIT.get_or_init(|| {
+        std::env::var("YSERVER_COPY_WAIT_US")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .map_or(0, |us| us.saturating_mul(1000))
+    })
+}
 
