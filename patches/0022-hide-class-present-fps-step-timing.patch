@@ -0,0 +1,100 @@
+//! Bannerlator launcher hooks.
+//!
+//! - `YSERVER_HIDE_CLASS=<name>[,<name>...]`: windows whose WM_CLASS instance or
+//!   class contains one of the names draw nothing and clear to black, as
+//!   Bannerlator's own X server leaves Wine's desktop (explorer.exe) out for game
+//!   shortcuts. Their children of other classes draw as usual.
+//! - Present counting: one `YSERVER-FPS` line a second for the window with the
+//!   most presents, so the launcher's HUD can show the game's own frame rate.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant};
+
+use yserver_protocol::x11::{AtomId, ResourceId};
+
+use crate::resources::ResourceTable;
+
+/// Predefined atom WM_CLASS (X11 core protocol).
+const WM_CLASS: AtomId = AtomId(67);
+
+fn hide_classes() -> &'static [String] {
+    static NAMES: OnceLock<Vec<String>> = OnceLock::new();
+    NAMES.get_or_init(|| {
+        std::env::var("YSERVER_HIDE_CLASS")
+            .map(|v| {
+                v.split(',')
+                    .map(|s| s.trim().to_ascii_lowercase())
+                    .filter(|s| !s.is_empty())
+                    .collect()
+            })
+            .unwrap_or_default()
+    })
+}
+
+/// The window draws nothing and clears to black.
+pub fn window_hidden(resources: &ResourceTable, window: u32) -> bool {
+    let names = hide_classes();
+    if names.is_empty() {
+        return false;
+    }
+    let Some(value) = resources.window_property(ResourceId(window), WM_CLASS) else {
+        return false;
+    };
+    value
+        .data
+        .split(|&b| b == 0)
+        .filter(|p| !p.is_empty())
+        .any(|part| {
+            let part = String::from_utf8_lossy(part).to_ascii_lowercase();
+            names.iter().any(|n| part.contains(n.as_str()))
+        })
+}
+
+/// The destination drawable of a core drawing request that paints into it
+/// (not ClearArea, which paints the background, nor GetImage).
+pub fn core_draw_target(opcode: u8, body: &[u8]) -> Option<u32> {
+    let at = match opcode {
+        62 | 63 => 4,
+        64..=72 | 74..=77 => 0,
+        _ => return None,
+    };
+    let b = body.get(at..at + 4)?;
+    Some(u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+struct FpsCounter {
+    since: Instant,
+    counts: HashMap<u32, u32>,
+}
+
+thread_local! {
+    static FPS: RefCell<Option<FpsCounter>> = const { RefCell::new(None) };
+}
+
+/// One present on `window`; once a second, report the busiest window.
+pub fn count_present(window: u32) {
+    FPS.with(|f| {
+        let mut f = f.borrow_mut();
+        let now = Instant::now();
+        let c = f.get_or_insert_with(|| FpsCounter {
+            since: now,
+            counts: HashMap::new(),
+        });
+        *c.counts.entry(window).or_insert(0) += 1;
+        let elapsed = now.duration_since(c.since);
+        if elapsed < Duration::from_secs(1) {
+            return;
+        }
+        if let Some((&w, &n)) = c.counts.iter().max_by_key(|(_, n)| **n) {
+            log::info!(
+                target: "yserver::bannerlator",
+                "YSERVER-FPS window=0x{w:x} fps={:.1}",
+                f64::from(n) / elapsed.as_secs_f64()
+            );
+        }
+        c.counts.clear();
+        c.since = now;
+    });
+}
