diff --git a/crates/yserver/src/tick_timing.rs b/crates/yserver/src/tick_timing.rs
new file mode 100644
index 0000000..0369a88
--- /dev/null
+++ b/crates/yserver/src/tick_timing.rs
@@ -0,0 +1,62 @@
+//! Debug (`YSERVER_TICK_TIMING=1`): the longest and the total time per second
+//! of each piece of backend work the core loop runs between requests.
+
+use std::cell::{Cell, RefCell};
+use std::time::{Duration, Instant};
+
+const N: usize = 14;
+const NAMES: [&str; N] = [
+    "scanout_composite", "rootless_tick", "host_flush", "reclaim_gpu", "flush_before_damage",
+    "rl.flush_paint", "ahb.record", "ahb.submit", "ahb.hand_over", "rl.poll_retiring",
+    "reclaim.poll_retired", "reclaim.pending_retire", "reclaim.trim_idle", "reclaim.telemetry",
+];
+
+thread_local! {
+    static MAX: RefCell<[Duration; N]> = const { RefCell::new([Duration::ZERO; N]) };
+    static SUM: RefCell<[Duration; N]> = const { RefCell::new([Duration::ZERO; N]) };
+    static LAST: Cell<Option<Instant>> = const { Cell::new(None) };
+}
+
+fn on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("YSERVER_TICK_TIMING").is_ok_and(|v| v == "1"))
+}
+
+pub(crate) fn start() -> Option<Instant> {
+    on().then(Instant::now)
+}
+
+pub(crate) fn record(i: usize, start: Option<Instant>) {
+    let Some(start) = start else { return };
+    let d = start.elapsed();
+    MAX.with(|m| {
+        let mut m = m.borrow_mut();
+        if d > m[i] {
+            m[i] = d;
+        }
+    });
+    SUM.with(|s| s.borrow_mut()[i] += d);
+}
+
+pub(crate) fn maybe_emit() {
+    if !on() {
+        return;
+    }
+    let now = Instant::now();
+    let last = LAST.with(|l| l.get());
+    let Some(last) = last else {
+        LAST.with(|l| l.set(Some(now)));
+        return;
+    };
+    if now.duration_since(last) < Duration::from_secs(1) {
+        return;
+    }
+    LAST.with(|l| l.set(Some(now)));
+    let max = MAX.with(|m| std::mem::replace(&mut *m.borrow_mut(), [Duration::ZERO; N]));
+    let sum = SUM.with(|s| std::mem::replace(&mut *s.borrow_mut(), [Duration::ZERO; N]));
+    let parts: Vec<String> = (0..N)
+        .filter(|&i| max[i] >= Duration::from_micros(200))
+        .map(|i| format!("{} max={:.2}ms sum={:.1}ms", NAMES[i], max[i].as_secs_f64() * 1000.0, sum[i].as_secs_f64() * 1000.0))
+        .collect();
+    log::info!("tick timing [{:.2}s]: {}", now.duration_since(last).as_secs_f64(), parts.join(" | "));
+}
