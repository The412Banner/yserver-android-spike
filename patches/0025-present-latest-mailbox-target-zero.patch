 /// "Newest frame only" (`YSERVER_PRESENT_LATEST`, on unless `0`): with
-/// `YSERVER_PRESENT_ASYNC=1`, a present the client marks async waits for the
-/// next host frame instead of running at once, and a newer one for the same
-/// window replaces it (supersession: the replaced buffer goes back idle,
-/// uncopied). The window then takes one copy per host frame instead of one per
-/// game frame. Presents without the async option still run at once.
+/// `YSERVER_PRESENT_ASYNC=1`, a present that asks for no particular frame
+/// (async option, or target 0 as Vulkan MAILBOX sends) waits for the next host
+/// frame instead of running at once, and a newer one for the same window
+/// replaces it (supersession: the replaced buffer goes back idle, uncopied).
+/// The window then takes one copy per host frame instead of one per game
+/// frame. Presents with an explicit target (FIFO) still run at once.
 pub fn present_latest() -> bool {
     static ON: OnceLock<bool> = OnceLock::new();
     *ON.get_or_init(|| std::env::var("YSERVER_PRESENT_LATEST").map_or(true, |v| v != "0"))
