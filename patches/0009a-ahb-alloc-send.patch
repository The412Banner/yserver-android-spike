+/// Allocate a buffer.
+///
+/// # Errors
+///
+/// gralloc refused the description.
+pub fn allocate(width: u32, height: u32, format: u32, usage: u64) -> io::Result<Ahb> {
+    let desc = AhbDesc {
+        width,
+        height,
+        layers: 1,
+        format,
+        usage,
+        ..AhbDesc::default()
+    };
+    let mut out: *mut libc::c_void = std::ptr::null_mut();
+    let rc = unsafe { AHardwareBuffer_allocate(&raw const desc, &raw mut out) };
+    if rc != 0 {
+        let errno = if rc < 0 { -rc } else { rc };
+        return Err(io::Error::from_raw_os_error(errno));
+    }
+    NonNull::new(out)
+        .map(Ahb)
+        .ok_or_else(|| io::Error::other("AHardwareBuffer_allocate gave no buffer"))
 }
 
