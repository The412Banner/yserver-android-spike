+/// `native_handle_t`'s head; `data` holds `num_fds` fds then `num_ints` ints.
+#[repr(C)]
+struct NativeHandle {
+    version: libc::c_int,
+    num_fds: libc::c_int,
+    num_ints: libc::c_int,
+    data: [libc::c_int; 0],
+}
+
+type GetNativeHandle = unsafe extern "C" fn(*const libc::c_void) -> *const NativeHandle;
+
+/// `AHardwareBuffer_getNativeHandle` (LL-NDK, not in the NDK stubs): looked up once.
+fn get_native_handle() -> Option<GetNativeHandle> {
+    static SYM: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let addr = *SYM.get_or_init(|| unsafe {
+        let lib = libc::dlopen(c"libnativewindow.so".as_ptr(), libc::RTLD_NOW);
+        let lib = if lib.is_null() { libc::RTLD_DEFAULT } else { lib };
+        libc::dlsym(lib, c"AHardwareBuffer_getNativeHandle".as_ptr()) as usize
+    });
+    (addr != 0).then(|| unsafe { std::mem::transmute::<usize, GetNativeHandle>(addr) })
+}
