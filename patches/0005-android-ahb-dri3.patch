diff --git a/crates/yserver-render/src/kms/vk/ahb.rs b/crates/yserver-render/src/kms/vk/ahb.rs
new file mode 100644
index 0000000..947666a
--- /dev/null
+++ b/crates/yserver-render/src/kms/vk/ahb.rs
@@ -0,0 +1,118 @@
+//! Android: a client hands a buffer over as an `AHardwareBuffer` through a
+//! socket fd (DRI3 `PixmapFromBuffers` with modifier 1255). The client sends
+//! the handle down a socketpair, passes the other end in the request, then
+//! blocks on a 1-byte read until the server writes one; the server receives
+//! the handle with `AHardwareBuffer_recvHandleFromUnixSocket` and imports it
+//! with `VK_ANDROID_external_memory_android_hardware_buffer`.
+
+use std::io;
+use std::os::fd::{AsRawFd, BorrowedFd};
+use std::ptr::NonNull;
+
+/// DRI3 modifier meaning "the fd is a socket carrying an AHardwareBuffer".
+pub const AHB_SOCKET_MODIFIER: u64 = 1255;
+
+/// `AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE`.
+pub const USAGE_GPU_SAMPLED_IMAGE: u64 = 1 << 8;
+/// `AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER` (`GPU_COLOR_OUTPUT`).
+pub const USAGE_GPU_FRAMEBUFFER: u64 = 1 << 9;
+
+/// How long the server waits for the handle once the request has arrived.
+const RECV_TIMEOUT_MS: libc::c_int = 1000;
+
+/// `AHardwareBuffer_Desc`.
+#[repr(C)]
+#[derive(Debug, Default, Clone, Copy)]
+pub struct AhbDesc {
+    pub width: u32,
+    pub height: u32,
+    pub layers: u32,
+    pub format: u32,
+    pub usage: u64,
+    pub stride: u32,
+    pub rfu0: u32,
+    pub rfu1: u64,
+}
+
+#[link(name = "nativewindow")]
+unsafe extern "C" {
+    fn AHardwareBuffer_recvHandleFromUnixSocket(
+        socket_fd: libc::c_int,
+        out_buffer: *mut *mut libc::c_void,
+    ) -> libc::c_int;
+    fn AHardwareBuffer_describe(buffer: *const libc::c_void, out_desc: *mut AhbDesc);
+    fn AHardwareBuffer_release(buffer: *mut libc::c_void);
+}
+
+/// One reference to an `AHardwareBuffer`, released on drop.
+pub struct Ahb(NonNull<libc::c_void>);
+
+// SAFETY: an AHardwareBuffer reference may be used and released from any thread.
+unsafe impl Send for Ahb {}
+
+impl Ahb {
+    #[must_use]
+    pub fn as_ptr(&self) -> *mut libc::c_void {
+        self.0.as_ptr()
+    }
+
+    #[must_use]
+    pub fn describe(&self) -> AhbDesc {
+        let mut desc = AhbDesc::default();
+        unsafe { AHardwareBuffer_describe(self.0.as_ptr(), &raw mut desc) };
+        desc
+    }
+}
+
+impl Drop for Ahb {
+    fn drop(&mut self) {
+        unsafe { AHardwareBuffer_release(self.0.as_ptr()) };
+    }
+}
+
+/// Write the one byte the client waits for. Never blocks.
+pub fn ack(socket: BorrowedFd<'_>) {
+    let byte = [1u8];
+    let _ = unsafe {
+        libc::send(
+            socket.as_raw_fd(),
+            byte.as_ptr().cast(),
+            1,
+            libc::MSG_DONTWAIT | libc::MSG_NOSIGNAL,
+        )
+    };
+}
+
+/// Receive the buffer handle the client wrote into the socket. Waits at most
+/// `RECV_TIMEOUT_MS` so a client that never sends cannot stall the server.
+///
+/// # Errors
+///
+/// Timeout, a closed socket, or the NDK call failing.
+pub fn receive(socket: BorrowedFd<'_>) -> io::Result<Ahb> {
+    let mut pfd = libc::pollfd {
+        fd: socket.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    let ready = unsafe { libc::poll(&raw mut pfd, 1, RECV_TIMEOUT_MS) };
+    if ready < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if ready == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::TimedOut,
+            "no AHardwareBuffer on the DRI3 socket",
+        ));
+    }
+    let mut out: *mut libc::c_void = std::ptr::null_mut();
+    let rc = unsafe { AHardwareBuffer_recvHandleFromUnixSocket(socket.as_raw_fd(), &raw mut out) };
+    if rc != 0 {
+        // The NDK returns 0 or a negative errno.
+        let errno = if rc < 0 { -rc } else { rc };
+        return Err(io::Error::from_raw_os_error(errno));
+    }
+    NonNull::new(out)
+        .map(Ahb)
+        .ok_or_else(|| io::Error::other("AHardwareBuffer_recvHandleFromUnixSocket gave no buffer"))
+}
