diff --git a/crates/yserver/src/kms/render/backend/android_ahb.rs b/crates/yserver/src/kms/render/backend/android_ahb.rs
new file mode 100644
index 0000000..efbc83f
--- /dev/null
+++ b/crates/yserver/src/kms/render/backend/android_ahb.rs
@@ -0,0 +1,121 @@
+//! Android DRI3: clients hand frames over as AHardwareBuffers through a
+//! socket fd (`PixmapFromBuffers` with modifier 1255, see
+//! `crate::kms::vk::ahb`). Android apps cannot open a DRM render node, so
+//! this is the only DRI3 import on Android.
+
+use std::io;
+use std::os::fd::AsFd as _;
+
+use yserver_core::backend::{Dri3Caps, Dri3ImportModifier, PixmapHandle};
+
+use super::XBackend;
+use super::seam::Platform;
+use crate::kms::render::store::{DrawableKind, ImportedDmabufMetadata, ImportedDmabufPlane, Storage};
+use crate::kms::vk::ahb;
+
+impl<P: Platform> XBackend<P> {
+    /// DRI3 1.2 (`PixmapFromBuffers`) when the AHardwareBuffer import is
+    /// available; no modifiers, fences or syncobjs.
+    pub(crate) fn android_dri3_capabilities(&self) -> Dri3Caps {
+        match self.platform.gpu().vk.as_ref() {
+            Some(vk) if vk.ahb.is_some() => Dri3Caps {
+                version: (1, 2),
+                modifiers: false,
+                fence_fd: false,
+                syncobj: false,
+            },
+            _ => Dri3Caps::unsupported(),
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn android_dri3_import_pixmap(
+        &mut self,
+        fd: yserver_core::fd::OwnedFd,
+        width: u16,
+        height: u16,
+        stride: u32,
+        _offset: u32,
+        modifier: Dri3ImportModifier,
+        depth: u8,
+        bpp: u8,
+    ) -> io::Result<PixmapHandle> {
+        if modifier != Dri3ImportModifier::Explicit(ahb::AHB_SOCKET_MODIFIER) {
+            return Err(io::Error::other(format!(
+                "DRI3 import on Android takes only modifier {} (AHardwareBuffer socket), got {modifier:?}",
+                ahb::AHB_SOCKET_MODIFIER
+            )));
+        }
+        // First, whatever happens next: the client blocks until this byte arrives.
+        ahb::ack(fd.as_fd());
+        if !matches!((depth, bpp), (24 | 32, 32)) {
+            return Err(io::Error::other(format!(
+                "DRI3 AHardwareBuffer import: unsupported depth {depth} bpp {bpp}"
+            )));
+        }
+        let Some(vk) = self.platform.gpu().vk.clone() else {
+            return Err(io::Error::other("DRI3 import: Vulkan unavailable"));
+        };
+        let buffer = ahb::receive(fd.as_fd())?;
+        let desc = buffer.describe();
+        if desc.width < u32::from(width) || desc.height < u32::from(height) {
+            return Err(io::Error::other(format!(
+                "DRI3 AHardwareBuffer {}x{} is smaller than the pixmap {width}x{height}",
+                desc.width, desc.height
+            )));
+        }
+        let drawable = crate::kms::vk::target::DrawableImage::from_ahb(
+            vk.clone(),
+            &buffer,
+            u32::from(width),
+            u32::from(height),
+            stride,
+        )
+        .map_err(|e| io::Error::other(format!("DRI3 AHardwareBuffer import: {e:?}")))?;
+        // The Vulkan memory holds its own reference from here on.
+        drop(buffer);
+        let vk_format = drawable.format;
+        let sample_view = crate::kms::render::gpu::GpuCore::build_sample_view(
+            &vk,
+            drawable.vk_image,
+            vk_format,
+            depth,
+        )
+        .map_err(|e| io::Error::other(format!("DRI3 AHardwareBuffer sample view: {e:?}")))?;
+        let fourcc = if depth == 32 {
+            u32::from_le_bytes(*b"AR24")
+        } else {
+            u32::from_le_bytes(*b"XR24")
+        };
+        let storage = Storage::from_imported_drawable_image(
+            drawable,
+            sample_view,
+            depth,
+            ImportedDmabufMetadata {
+                fourcc,
+                vk_format,
+                modifier: ahb::AHB_SOCKET_MODIFIER,
+                implicit_layout: false,
+                planes: vec![ImportedDmabufPlane {
+                    offset: 0,
+                    pitch: stride,
+                }],
+                width,
+                height,
+                depth,
+                bpp,
+            },
+        );
+        let host_xid = self.core.next_host_xid();
+        self.store_alloc(host_xid, DrawableKind::Pixmap, depth, false, storage)
+            .map_err(|e| io::Error::other(format!("DRI3 import store.allocate: {e:?}")))?;
+        self.telemetry.record_storage_allocation();
+        self.telemetry.record_image_view_create();
+        log::info!(
+            "dri3: AHardwareBuffer {}x{} format {} usage 0x{:x} stride {} -> {vk_format:?} pixmap {width}x{height} (host 0x{host_xid:x})",
+            desc.width, desc.height, desc.format, desc.usage, desc.stride
+        );
+        PixmapHandle::from_raw(host_xid)
+            .ok_or_else(|| io::Error::other("DRI3 import: failed to make PixmapHandle"))
+    }
+}
