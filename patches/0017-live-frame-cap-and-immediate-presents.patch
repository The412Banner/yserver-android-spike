diff --git a/crates/yserver-core/src/frame_cap.rs b/crates/yserver-core/src/frame_cap.rs
new file mode 100644
index 0000000..3158814
--- /dev/null
+++ b/crates/yserver-core/src/frame_cap.rs
@@ -0,0 +1,54 @@
+//! Bannerlator: the frame cap (FPS limiter), live. `YSERVER_PRESENT_HZ` sets
+//! it at start; when `YSERVER_FPS_FILE` names a file, a thread reads it a few
+//! times a second (an integer fps, 0 = no cap) so the launcher's in-game
+//! limiter applies at once. The rootless Present clock runs at the cap, a
+//! window's presents take one MSC each, and async presents are off while it
+//! is set.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static CAP_MHZ: AtomicU64 = AtomicU64::new(0);
+static STARTED: std::sync::Once = std::sync::Once::new();
+
+fn parse_mhz(text: &str) -> u64 {
+    text.trim()
+        .parse::<f64>()
+        .ok()
+        .filter(|hz| *hz >= 1.0 && *hz <= 1000.0)
+        .map_or(0, |hz| (hz * 1000.0) as u64)
+}
+
+fn start() {
+    STARTED.call_once(|| {
+        if let Ok(v) = std::env::var("YSERVER_PRESENT_HZ") {
+            CAP_MHZ.store(parse_mhz(&v), Ordering::Relaxed);
+        }
+        let Some(path) = std::env::var_os("YSERVER_FPS_FILE") else {
+            return;
+        };
+        let path = std::path::PathBuf::from(path);
+        let _ = std::thread::Builder::new()
+            .name("yserver-fps-file".into())
+            .spawn(move || {
+                let mut last = None;
+                loop {
+                    let text = std::fs::read_to_string(&path).ok();
+                    if text != last {
+                        let mhz = text.as_deref().map_or(0, parse_mhz);
+                        if CAP_MHZ.swap(mhz, Ordering::Relaxed) != mhz {
+                            log::info!(target: "yserver::bannerlator", "frame cap: {} fps", mhz / 1000);
+                        }
+                        last = text;
+                    }
+                    std::thread::sleep(std::time::Duration::from_millis(200));
+                }
+            });
+    });
+}
+
+/// The cap in millihertz, 0 when off.
+#[must_use]
+pub fn cap_mhz() -> u64 {
+    start();
+    CAP_MHZ.load(Ordering::Relaxed)
+}
