+quiet!(
+    WlCompositor,
+    WlShm,
+    WlShmPool,
+    XdgPositioner,
+    ZxdgOutputManagerV1,
+    WpCursorShapeManagerV1,
+    WpCursorShapeDeviceV1,
+    ZwpRelativePointerManagerV1,
+    ZwpPointerConstraintsV1,
+    ExtDataControlManagerV1,
+);
