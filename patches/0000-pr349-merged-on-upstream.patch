+impl Dispatch<WlSeat, ()> for State {
+    fn event(
+        state: &mut Self,
+        seat: &WlSeat,
+        event: wl_seat::Event,
+        (): &(),
+        _: &Connection,
+        qh: &QueueHandle<Self>,
+    ) {
+        let wl_seat::Event::Capabilities {
+            capabilities: WEnum::Value(capabilities),
+        } = event
+        else {
+            return;
+        };
+        // A device the seat lost is let go, and made anew when the seat has
+        // one again: an object made before the capability came back hears
+        // nothing (`wl_seat.capabilities`), so kept, it would leave X
+        // without that input from the first unplugged mouse or sleeping
+        // keyboard on.
+        match (
+            state.seat.pointer.is_some(),
+            capabilities.contains(wl_seat::Capability::Pointer),
+        ) {
+            (false, true) => {
+                let pointer = seat.get_pointer(qh, ());
+                if let Some(manager) = &state.cursor_shape {
+                    state.seat.cursor_device = Some(manager.get_pointer(&pointer, qh, ()));
+                }
+                state.seat.pointer = Some(pointer);
+            }
+            (true, false) => state.seat.lose_pointer(&mut state.pending),
+            _ => {}
+        }
+        match (
+            state.seat.keyboard.is_some(),
+            capabilities.contains(wl_seat::Capability::Keyboard),
+        ) {
+            (false, true) => state.seat.keyboard = Some(seat.get_keyboard(qh, ())),
+            (true, false) => state.seat.lose_keyboard(&mut state.pending),
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<WlPointer, ()> for State {
+    fn event(
+        state: &mut Self,
+        pointer: &WlPointer,
+        event: wl_pointer::Event,
+        (): &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let seat = &mut state.seat;
+        match event {
+            wl_pointer::Event::Enter {
+                serial,
+                surface,
+                surface_x: x,
+                surface_y: y,
+            } => {
+                let Some(surface) = Self::surface_of(&surface) else {
+                    return;
+                };
+                let seat = &mut state.seat;
+                seat.enter_serial = serial;
+                seat.pointer_focus = Some(surface);
+                seat.pointer_at = (x, y);
+                seat.apply_cursor();
+                state
+                    .pending
+                    .push(Event::Pointer(PointerEvent::Enter { surface, x, y }));
+            }
+            wl_pointer::Event::Leave { .. } => {
+                if seat.pointer_focus.take().is_some() {
+                    state.pending.push(Event::Pointer(PointerEvent::Leave));
+                }
+            }
+            wl_pointer::Event::Motion {
+                surface_x: x,
+                surface_y: y,
+                ..
+            } => {
+                seat.pointer_at = (x, y);
+                if let Some(surface) = seat.pointer_focus {
+                    state
+                        .pending
+                        .push(Event::Pointer(PointerEvent::Motion { surface, x, y }));
+                }
+            }
+            wl_pointer::Event::Button {
+                serial,
+                button,
+                state: pressed,
+                ..
+            } => {
+                let pressed = pressed == WEnum::Value(wl_pointer::ButtonState::Pressed);
+                if pressed {
+                    seat.input_serial = serial;
+                }
+                if let Some(surface) = seat.pointer_focus {
+                    let (x, y) = seat.pointer_at;
+                    state.pending.push(Event::Pointer(PointerEvent::Button {
+                        surface,
+                        x,
+                        y,
+                        button,
+                        pressed,
+                    }));
+                }
+            }
+            wl_pointer::Event::Axis { axis, value, .. } => {
+                let sum = seat.axis.get_or_insert_with(Axis::default);
+                if axis == WEnum::Value(wl_pointer::Axis::VerticalScroll) {
+                    sum.vertical += value;
+                } else {
+                    sum.horizontal += value;
+                }
+                // Before version 5 there is no frame to wait for.
+                if pointer.version() < 5 {
+                    state.flush_axis();
+                }
+            }
+            wl_pointer::Event::AxisDiscrete { axis, discrete } => {
+                let sum = seat.axis.get_or_insert_with(Axis::default);
+                if axis == WEnum::Value(wl_pointer::Axis::VerticalScroll) {
+                    sum.discrete.0 = sum.discrete.0.saturating_add(discrete);
+                } else {
+                    sum.discrete.1 = sum.discrete.1.saturating_add(discrete);
+                }
+            }
+            wl_pointer::Event::AxisSource { axis_source } => {
+                if matches!(
+                    axis_source,
+                    WEnum::Value(wl_pointer::AxisSource::Wheel | wl_pointer::AxisSource::WheelTilt)
+                ) {
+                    seat.axis.get_or_insert_with(Axis::default).counted = (true, true);
+                }
+            }
+            wl_pointer::Event::AxisValue120 { axis, value120 } => {
+                let vertical = axis == WEnum::Value(wl_pointer::Axis::VerticalScroll);
+                let counted = &mut seat.axis.get_or_insert_with(Axis::default).counted;
+                if vertical {
+                    counted.0 = true;
+                } else {
+                    counted.1 = true;
+                }
+                let residue = if vertical {
+                    &mut seat.residue.0
+                } else {
+                    &mut seat.residue.1
+                };
+                *residue = residue.saturating_add(value120);
+                let clicks = *residue / 120;
+                *residue -= clicks * 120;
+                let sum = seat.axis.get_or_insert_with(Axis::default);
+                if vertical {
+                    sum.discrete.0 = sum.discrete.0.saturating_add(clicks);
+                } else {
+                    sum.discrete.1 = sum.discrete.1.saturating_add(clicks);
+                }
+            }
+            wl_pointer::Event::Frame => state.flush_axis(),
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<WlKeyboard, ()> for State {
+    fn event(
+        state: &mut Self,
+        _: &WlKeyboard,
+        event: wl_keyboard::Event,
+        (): &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        match event {
+            wl_keyboard::Event::Keymap { format, fd, size } => {
+                if format == WEnum::Value(wl_keyboard::KeymapFormat::XkbV1) {
+                    state.seat.read_keymap(fd, size);
+                }
+            }
+            wl_keyboard::Event::Enter { surface, .. } => {
+                if let Some(surface) = Self::surface_of(&surface) {
+                    state.seat.keyboard_focus = true;
+                    state
+                        .pending
+                        .push(Event::Keyboard(KeyboardEvent::Enter(surface)));
+                }
+            }
+            wl_keyboard::Event::Leave { .. } => {
+                state.seat.keyboard_focus = false;
+                state.pending.push(Event::Keyboard(KeyboardEvent::Leave));
+            }
+            wl_keyboard::Event::Key {
+                serial,
+                key,
+                state: key_state,
+                ..
+            } => {
+                let pressed = key_state == WEnum::Value(wl_keyboard::KeyState::Pressed);
+                if pressed {
+                    state.seat.input_serial = serial;
+                }
+                state
+                    .pending
+                    .push(Event::Keyboard(KeyboardEvent::Key { code: key, pressed }));
+            }
+            wl_keyboard::Event::Modifiers {
+                mods_depressed,
+                mods_latched,
+                mods_locked,
+                group,
+                ..
+            } => {
+                state.seat.group = group;
+                let x = state
+                    .seat
+                    .x_state(mods_depressed, mods_latched, mods_locked, group);
+                state
+                    .pending
+                    .push(Event::Keyboard(KeyboardEvent::Modifiers(x)));
+            }
+            _ => {}
+        }
+    }
+}
