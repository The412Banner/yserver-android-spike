+/// Objects whose events the host does not need.
+macro_rules! quiet {
+    ($($interface:ty),* $(,)?) => {$(
+        impl Dispatch<$interface, ()> for State {
+            fn event(
+                _: &mut Self,
+                _: &$interface,
+                _: <$interface as Proxy>::Event,
+                (): &(),
+                _: &Connection,
+                _: &QueueHandle<Self>,
+            ) {
+            }
+        }
+    )*};
+}
