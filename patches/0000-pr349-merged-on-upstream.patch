+    #[test]
+    fn a_keymaps_group_name_is_a_layout_and_variant_of_the_rules() {
+        let named = |label| layout_named(RULES, label);
+        assert_eq!(named("German"), Some(("de".to_owned(), String::new())));
+        assert_eq!(
+            named("German (no dead keys)"),
+            Some(("de".to_owned(), "nodeadkeys".to_owned()))
+        );
+        assert_eq!(
+            named("English (Dvorak)"),
+            Some(("us".to_owned(), "dvorak".to_owned()))
+        );
+        assert_eq!(named("Generic 105-key PC"), None, "a model is no layout");
+        assert_eq!(named("Klingon"), None);
+    }
+
+    /// The compositor's masks are of its keymap's modifiers, virtual ones
+    /// too: X gets the real ones they are, per component, and the group.
+    #[test]
+    fn the_compositors_modifiers_are_xs_real_ones() {
+        let context = xkb::Context::new(xkb::CONTEXT_NO_FLAGS);
+        let keymap = xkb::Keymap::new_from_names(
+            &context,
+            "evdev",
+            "pc105",
+            "us,de",
+            "",
+            None,
+            xkb::KEYMAP_COMPILE_NO_FLAGS,
+        )
+        .expect("us,de");
+        let bit = |name| 1u32 << keymap.mod_get_index(name);
+        let state = x_state(
+            &keymap,
+            [bit("Shift"), bit("Control"), bit("NumLock") | bit("Lock")],
+            1,
+        );
+        assert_eq!(
+            state,
+            HostKeyboardState {
+                depressed: 0x01,
+                latched: 0x04,
+                // NumLock is Mod2.
+                locked: 0x12,
+                group: 1,
+            }
+        );
+        assert_eq!(x_state(&keymap, [0; 3], 5).group, 1, "wrapped to two");
+    }
+
+    /// A keymap is the `size` bytes the file holds, at most the limit, up
+    /// to its NUL.
+    #[test]
+    fn a_keymap_is_read_within_its_file_and_the_limit() {
+        use std::io::Write as _;
+        let path = std::env::temp_dir().join(format!("yserver-keymap-{}", std::process::id()));
+        let mut file = std::fs::File::create(&path).unwrap();
+        file.write_all(b"xkb_keymap {};\0").unwrap();
+        let open = || OwnedFd::from(std::fs::File::open(&path).unwrap());
+        assert_eq!(keymap_text(open(), 15).unwrap(), "xkb_keymap {};");
+        assert!(keymap_text(open(), 16).is_err(), "more than the file");
+        assert!(keymap_text(open(), 0).is_err());
+        assert!(keymap_text(open(), u32::MAX).is_err(), "over the limit");
+        std::fs::remove_file(&path).unwrap();
+    }
+
+    /// One notch of a high-resolution wheel, in four frames of a quarter
+    /// notch each (`axis_value120` 30, and 3.75 of continuous scroll), is
+    /// one click: with the continuous value counted as well it was two. A
+    /// touchpad's continuous scroll is kept.
+    #[test]
+    fn a_wheel_frame_is_its_clicks_alone() {
+        let mut residue = 0.0;
+        let clicks: i32 = [0, 0, 0, 1]
+            .into_iter()
+            .map(|discrete| {
+                let frame = Axis {
+                    vertical: 3.75,
+                    discrete: (discrete, 0),
+                    counted: (true, false),
+                    ..Axis::default()
+                };
+                let PointerEvent::Axis {
+                    vertical, discrete, ..
+                } = frame.scroll()
+                else {
+                    unreachable!("a scroll")
+                };
+                super::super::input::clicks(&mut residue, vertical, discrete.0)
+            })
+            .sum();
+        assert_eq!(clicks, 1);
+        let touchpad = Axis {
+            vertical: 12.0,
+            horizontal: -3.0,
+            ..Axis::default()
+        };
+        let PointerEvent::Axis {
+            vertical,
+            horizontal,
+            ..
+        } = touchpad.scroll()
+        else {
+            unreachable!("a scroll")
+        };
+        assert!((vertical - 12.0).abs() < f64::EPSILON && (horizontal + 3.0).abs() < f64::EPSILON);
+    }
+
+    /// A configure that leaves the size to the window answers with the
+    /// size it has: the compositor's last, or the one X gave it since (a
+    /// font change, a game's resolution), not the one it had before.
+    #[test]
+    fn a_window_keeps_the_size_x_gave_it() {
+        let mut size = WindowSize::new((100, 100));
+        assert_eq!(size.commit(), (100, 100), "the size asked for");
+        size.pending = (640, 480);
+        assert_eq!(size.commit(), (640, 480));
+        size.pending = (0, 0);
+        assert_eq!(size.commit(), (640, 480), "floated: kept");
+        // X resizes it (Client::resized_by_x).
+        size.has = (800, 600);
+        size.pending = (0, 0);
+        assert_eq!(size.commit(), (800, 600), "X's size, not 640x480");
+        size.pending = (1024, 0);
+        assert_eq!(size.commit(), (1024, 600));
+    }
+
+    #[test]
+    fn an_outputs_logical_size_is_xdg_outputs_else_the_mode_over_the_scale() {
+        let mut output = Output {
+            mode: (2560, 1440),
+            scale: 2,
+            ..Output::default()
+        };
+        assert_eq!(output.logical_size(), (1280, 720));
+        output.sideways = true;
+        assert_eq!(output.logical_size(), (720, 1280));
+        output.logical_extent = Some((1707, 960));
+        assert_eq!(output.logical_size(), (1707, 960));
+    }
+
+    #[test]
+    fn a_buffers_length_is_four_bytes_a_pixel_and_fits_an_int() {
+        assert_eq!(length(2, 3), Some(24));
+        assert_eq!(length(0, 3), None);
+        assert_eq!(length(65536, 65536), None);
+    }
+
+    /// A flush into a full socket leaves the request queued and says so; once
+    /// the compositor reads, the next flush sends it and says it is out.
+    #[test]
+    fn a_flush_into_a_full_socket_says_what_stays_queued() {
+        use std::io::{Read as _, Write as _};
+        let (host, mut compositor) = std::os::unix::net::UnixStream::pair().unwrap();
+        host.set_nonblocking(true).unwrap();
+        let mut filled = 0usize;
+        loop {
+            match (&host).write(&[0u8; 4096]) {
+                Ok(n) => filled += n,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => break,
+                Err(error) => panic!("{error}"),
+            }
+        }
+        let connection = Connection::from_socket(host).unwrap();
+        let queue = connection.new_event_queue::<State>();
+        let _registry = connection.display().get_registry(&queue.handle(), ());
+        assert!(flush(&connection).unwrap(), "the request stays queued");
+        compositor.set_nonblocking(true).unwrap();
+        let mut buf = vec![0u8; 64 << 10];
+        let mut read = 0usize;
+        while read < filled {
+            read += compositor.read(&mut buf).unwrap();
+        }
+        assert!(!flush(&connection).unwrap(), "the request went out");
+        // wl_display.get_registry: object 1, opcode 1, 12 bytes.
+        let n = compositor.read(&mut buf).unwrap();
+        assert_eq!(n, 12);
+        assert_eq!(u32::from_ne_bytes(buf[..4].try_into().unwrap()), 1);
+    }
+
+    /// One message on the wire: the object, the opcode and its arguments.
+    fn message(object: u32, opcode: u16, arguments: &[u8]) -> Vec<u8> {
+        let size = u32::try_from(8 + arguments.len()).unwrap();
+        let mut out = object.to_ne_bytes().to_vec();
+        out.extend_from_slice(&((size << 16) | u32::from(opcode)).to_ne_bytes());
+        out.extend_from_slice(arguments);
+        out
+    }
+
+    /// The requests in `bytes`: each one's object and opcode.
+    fn requests(bytes: &[u8]) -> Vec<(u32, u16)> {
+        let word = |at: usize| u32::from_ne_bytes(bytes[at..at + 4].try_into().unwrap());
+        let (mut at, mut out) = (0, Vec::new());
+        while at + 8 <= bytes.len() {
+            let head = word(at + 4);
+            out.push((word(at), u16::try_from(head & 0xffff).unwrap()));
+            at += usize::try_from(head >> 16).unwrap();
+        }
+        out
+    }
+
+    /// A seat that loses its pointer and keyboard and has them again: the
+    /// old objects are released and new ones made, since the compositor
+    /// sends nothing to one made before the capability came back. The
+    /// pointer leaves the window it was on, and what was made on it goes.
+    #[test]
+    fn a_seat_device_lost_and_back_is_made_anew() {
+        use std::io::{Read as _, Write as _};
+        let (host, mut compositor) = std::os::unix::net::UnixStream::pair().unwrap();
+        host.set_nonblocking(true).unwrap();
+        let connection = Connection::from_socket(host).unwrap();
+        let queue = connection.new_event_queue::<State>();
+        let qh = queue.handle();
+        let registry = connection.display().get_registry(&qh, ());
+        let mut client = Client {
+            connection,
+            queue,
+            qh,
+            registry,
+            state: State::default(),
+            next_surface: 1,
+            unsent: Cell::new(false),
+        };
+        // wl_registry.global: name 7, "wl_seat" (8 bytes with its NUL),
+        // version 8. The registry is object 2.
+        let mut global = 7u32.to_ne_bytes().to_vec();
+        global.extend_from_slice(&8u32.to_ne_bytes());
+        global.extend_from_slice(b"wl_seat\0");
+        global.extend_from_slice(&8u32.to_ne_bytes());
+        compositor.write_all(&message(2, 0, &global)).unwrap();
+        client.dispatch().unwrap();
+        let seat = client.seat().expect("the seat is bound").id().protocol_id();
+        let mut capabilities = |client: &mut Client, bits: u32| {
+            compositor
+                .write_all(&message(seat, 0, &bits.to_ne_bytes()))
+                .unwrap();
+            client.dispatch().unwrap()
+        };
+        let id = |proxy: Option<u32>| proxy.expect("made");
+        let devices = |client: &Client| {
+            (
+                client
+                    .state
+                    .seat
+                    .pointer
+                    .as_ref()
+                    .map(|p| p.id().protocol_id()),
+                client
+                    .state
+                    .seat
+                    .keyboard
+                    .as_ref()
+                    .map(|k| k.id().protocol_id()),
+            )
+        };
+
+        // Pointer and keyboard; then neither; then both again.
+        capabilities(&mut client, 3);
+        let (pointer, keyboard) = devices(&client);
+        let (pointer, keyboard) = (id(pointer), id(keyboard));
+        client.state.seat.pointer_focus = Some(SurfaceId(1));
+        client.state.seat.keyboard_focus = true;
+        let events = capabilities(&mut client, 0);
+        assert_eq!(devices(&client), (None, None));
+        assert!(
+            matches!(
+                events.as_slice(),
+                [
+                    Event::Pointer(PointerEvent::Leave),
+                    Event::Pointer(PointerEvent::Gone),
+                    Event::Keyboard(KeyboardEvent::Leave),
+                ]
+            ),
+            "{events:?}"
+        );
+        capabilities(&mut client, 3);
+        let (new_pointer, new_keyboard) = devices(&client);
+        let (new_pointer, new_keyboard) = (id(new_pointer), id(new_keyboard));
+        assert_ne!(new_pointer, pointer);
+        assert_ne!(new_keyboard, keyboard);
+        // The same capabilities again make nothing new.
+        capabilities(&mut client, 3);
+        assert_eq!(devices(&client), (Some(new_pointer), Some(new_keyboard)));
+
+        client.flush().unwrap();
+        compositor.set_nonblocking(true).unwrap();
+        let mut sent = Vec::new();
+        let _ = compositor.read_to_end(&mut sent);
+        let sent: Vec<(u32, u16)> = requests(&sent)
+            .into_iter()
+            .filter(|(object, _)| [seat, pointer, keyboard].contains(object))
+            .collect();
+        assert_eq!(
+            sent,
+            [
+                (seat, 0),     // wl_seat.get_pointer
+                (seat, 1),     // wl_seat.get_keyboard
+                (pointer, 1),  // wl_pointer.release
+                (keyboard, 0), // wl_keyboard.release
+                (seat, 0),
+                (seat, 1),
+            ]
+        );
+    }
+
+    #[test]
+    fn a_compositor_without_a_required_global_is_named() {
+        assert_eq!(missing_global(true, true, true), None);
+        assert_eq!(missing_global(false, true, true), Some("wl_compositor"));
+        assert_eq!(missing_global(true, false, true), Some("wl_shm"));
+        assert_eq!(missing_global(true, true, false), Some("xdg_wm_base"));
+    }
+}
