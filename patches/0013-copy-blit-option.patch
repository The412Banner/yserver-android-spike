+/// `YSERVER_COPY_BLIT=1`: disjoint copies go through `vkCmdBlitImage`
+/// (Adreno's proprietary driver allocates and clears GPU memory inside every
+/// `vkCmdCopyImage`).
+pub fn copy_via_blit() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("YSERVER_COPY_BLIT").is_some_and(|v| v == "1"))
+}
