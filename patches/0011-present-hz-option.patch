+/// `YSERVER_PRESENT_HZ`: a Present clock of its own rate instead of the
+/// host's refresh (a frame-rate cap for synced presents), 0/unset = host.
+fn present_hz_override() -> u64 {
+    static HZ: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *HZ.get_or_init(|| {
+        std::env::var("YSERVER_PRESENT_HZ")
+            .ok()
+            .and_then(|v| v.trim().parse::<f64>().ok())
+            .filter(|hz| *hz >= 1.0 && *hz <= 1000.0)
+            .map_or(0, |hz| (hz * 1000.0) as u64)
+    })
+}
